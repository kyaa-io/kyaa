{
  "name": "byus",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/web",
    "apps/worker"
  ],
  "dependencies": {
    "@solana-program/memo": "0.10.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    },
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    },
    "ws@>=8.0.0 <8.21.0": "8.21.1",
    "@walletconnect/utils@>=2.21.0 <2.21.9": "2.21.9",
    "fast-glob": "$fast-glob",
    "zod@<4.6.6": "4.6.7"
  },
  "scripts": {
    "env:local:dev": "node scripts/sync-web-dev-env.mjs",
    "env:local:prod": "node scripts/sync-web-env.mjs prod-local",
    "dev:test": "node scripts/run-web-dev.mjs",
    "dev": "node scripts/verify-local-production-env.mjs && npm run dev --workspace @byus/web",
    "build": "npm run build --workspace @byus/web",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace @byus/web",
    "test:e2e": "npm run test:e2e --workspace @byus/web",
    "typecheck": "npm run typecheck --workspace @byus/web",
    "lint": "eslint apps/web apps/worker scripts --max-warnings=0",
    "lint:web": "eslint apps/web --max-warnings=0",
    "lint:worker": "eslint apps/worker --max-warnings=0",
    "security:audit": "npm audit --omit=dev --ignore-scripts",
    "security:backend-db": "bash scripts/verify-backend-security.sh",
    "security:audit:baseline": "node scripts/verify-npm-audit-baseline.mjs",
    "security:tree": "npm ls @aws-sdk/client-secrets-manager fast-xml-parser axios ws postcss uuid --all",
    "security:verify": "node scripts/verify-security-dependencies.mjs",
    "security:ws-canary": "node scripts/verify-websocket-canary.mjs",
    "media:prepare-live-preview": "node scripts/prepare-live-preview.mjs",
    "test:media-preview": "node --test scripts/live-preview-pipeline.contract.test.mjs",
    "telegram:bugs": "node scripts/telegram-bug-reports.mjs",
    "postinstall": "node scripts/apply-security-patches.mjs",
    "security:patch": "node scripts/apply-security-patches.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-glob": "file:tools/eslint-root-glob"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
