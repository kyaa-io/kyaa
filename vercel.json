{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "buildCommand": "npm run build --workspace @byus/web",
  "outputDirectory": "apps/web/.next",
  "regions": ["icn1"],
  "crons": [
    { "path": "/api/internal/seo/indexnow", "schedule": "*/5 * * * *" },
    { "path": "/api/internal/instagram/sync", "schedule": "15 * * * *" },
    { "path": "/api/internal/instagram/live-sync", "schedule": "* * * * *" },
    { "path": "/api/internal/chzzk/live-sync", "schedule": "* * * * *" },
    { "path": "/api/internal/account-deletions/process", "schedule": "*/15 * * * *" }
  ]
}
