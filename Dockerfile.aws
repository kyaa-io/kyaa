# Build on the ECS runtime architecture; no environment files or secrets enter the context.
ARG NODE_BUILD_BASE=node:24-bookworm-slim
ARG MEDIA_LAMBDA_BASE=public.ecr.aws/lambda/nodejs:24
# Empty default for the Next compiler cache; the release workflow overrides it with --build-context nextcache=... and CodeBuild builds without it.
FROM scratch AS nextcache

FROM --platform=linux/amd64 ${NODE_BUILD_BASE} AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY tools ./tools
COPY scripts/apply-security-patches.mjs scripts/apply-security-patches.mjs
# ffmpeg-static downloads its binary from GitHub releases during npm ci; retry the whole install (10, 20, 40 s) on a transient failure. Its own integrity check still runs each attempt.
RUN d=10; for n in 1 2 3 4; do npm ci --include=dev && exit 0; [ "$n" = 4 ] && exit 1; echo "npm ci failed (attempt $n of 4); retrying in ${d}s" >&2; sleep "$d"; d=$((d*2)); done
COPY . .
ENV HOSTING_PROVIDER=aws NEXT_BUILD_CACHE=1
# The restored build cache replaces the empty nextcache stage via --build-context, never through the main context.
# It holds turbopack/ and typecheck/buildinfo; with the latter Next re-checks only what changed instead of every file (4.5-7 min).
COPY --from=nextcache / apps/web/.next/cache/
RUN if [ -f apps/web/.next/cache/typecheck/buildinfo ]; then mv apps/web/.next/cache/typecheck/buildinfo apps/web/.next/cache/.tsbuildinfo; fi
# Separate containers share the exact source/config/cache snapshot without sharing writable .next outputs.
FROM build AS typecheck
ENV NODE_ENV=production
RUN cd apps/web && NODE_OPTIONS=--max-old-space-size=6144 npx next typegen && NODE_OPTIONS=--max-old-space-size=6144 npx tsc --noEmit -p tsconfig.aws.json --tsBuildInfoFile .next/cache/.tsbuildinfo
RUN touch /tmp/kyaa-web-typecheck-passed

FROM build AS bundle
RUN KYAA_AWS_BUILD_PHASE=bundle NODE_OPTIONS=--max-old-space-size=6144 npm run build --workspace @byus/web

# Every published image and cache export requires both successful branches.
FROM bundle AS verified
COPY --from=typecheck /tmp/kyaa-web-typecheck-passed /tmp/kyaa-web-typecheck-passed
COPY --from=typecheck /app/apps/web/.next/cache/.tsbuildinfo /app/apps/web/.next/cache/.tsbuildinfo

FROM scratch AS next-cache-export
COPY --from=verified /app/apps/web/.next/cache/turbopack/ /turbopack/
COPY --from=verified /app/apps/web/.next/cache/.tsbuildinfo /typecheck/buildinfo

FROM --platform=linux/amd64 ${NODE_BUILD_BASE} AS runtime
WORKDIR /app
RUN groupadd --gid 1001 app && useradd --uid 1001 --gid app --home-dir /app app
# Node closes idle sockets after 5s by default, while the ALB reuses them for up to its 60s idle timeout;
# the race surfaces as sporadic 502s. Keep the app's keep-alive longer than the ALB's.
ENV NODE_ENV=production HOSTING_PROVIDER=aws NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 KEEP_ALIVE_TIMEOUT=65000
COPY --from=verified --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=verified --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=verified --chown=app:app /app/apps/web/public ./apps/web/public
RUN mkdir -p apps/web/.next/cache && chown app:app apps/web/.next/cache
USER app
EXPOSE 3000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Exec form preserves Next's native SIGTERM connection draining.
CMD ["node", "apps/web/server.js"]
