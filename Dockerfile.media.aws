ARG NODE_BUILD_BASE=node:24-bookworm-slim
ARG MEDIA_LAMBDA_BASE=public.ecr.aws/lambda/nodejs:24
FROM --platform=linux/amd64 ${NODE_BUILD_BASE} AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY tools ./tools
COPY scripts/apply-security-patches.mjs scripts/apply-security-patches.mjs
# ffmpeg-static downloads its binary from GitHub releases during npm ci; retry the whole install (10, 20, 40 s) on a transient failure. Its own integrity check still runs each attempt.
RUN d=10; for n in 1 2 3 4; do npm ci --include=dev && exit 0; [ "$n" = 4 ] && exit 1; echo "npm ci failed (attempt $n of 4); retrying in ${d}s" >&2; sleep "$d"; d=$((d*2)); done
COPY . .
RUN node scripts/aws-release-media-build.mjs
RUN npm prune --omit=dev

FROM --platform=linux/amd64 ${MEDIA_LAMBDA_BASE}
COPY --from=build /app/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY --from=build /app/work/aws-media/index.cjs ${LAMBDA_TASK_ROOT}/index.cjs
ENV NODE_ENV=production HOSTING_PROVIDER=aws
# Native ffmpeg, ffprobe and sharp resolve from installed Linux packages at runtime.
CMD ["index.handler"]
