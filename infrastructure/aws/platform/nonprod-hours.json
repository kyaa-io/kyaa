{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Optional dev/staging Seoul weekday office hours for exact tagged ECS service and RDS instance; never production",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "AllowedValues": [
        "dev",
        "staging"
      ]
    },
    "ExpectedAccountId": {
      "Type": "String",
      "AllowedValues": [
        "996702758024"
      ]
    },
    "ClusterName": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9_-]{1,255}"
    },
    "ServiceName": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9_-]{1,255}"
    },
    "DatabaseInstanceIdentifier": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "|[a-z][a-z0-9-]{0,62}"
    },
    "EnableSchedules": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "EnableDatabaseSchedules": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Enable only for a nonproduction RDS instance tagged Environment=<environment>"
    },
    "AlarmTopicArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "|arn:aws:sns:ap-northeast-2:996702758024:[A-Za-z0-9_-]+"
    }
  },
  "Rules": {
    "AccountAndRegion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::AccountId"
              },
              {
                "Ref": "ExpectedAccountId"
              }
            ]
          },
          "AssertDescription": "Use explicitly approved Sallylab account"
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "ap-northeast-2"
            ]
          },
          "AssertDescription": "Use Seoul region"
        }
      ]
    },
    "DatabaseRequired": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "EnableDatabaseSchedules"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "DatabaseInstanceIdentifier"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "An explicit RDS identifier is required when database schedules are enabled"
        }
      ]
    }
  },
  "Conditions": {
    "SchedulesEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableSchedules"
        },
        "true"
      ]
    },
    "DatabaseConfigured": {
      "Fn::Equals": [
        {
          "Ref": "EnableDatabaseSchedules"
        },
        "true"
      ]
    },
    "DatabaseSchedulesEnabled": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnableSchedules"
            },
            "true"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnableDatabaseSchedules"
            },
            "true"
          ]
        }
      ]
    },
    "HasAlarmTopic": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlarmTopicArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Group": {
      "Type": "AWS::Scheduler::ScheduleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "byus-office-hours-${Environment}"
        }
      }
    },
    "DeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "byus-office-hours-${Environment}-dlq"
        },
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "QueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "DeadLetterQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": {
                "Fn::GetAtt": [
                  "DeadLetterQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule-group/${Group}"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "exact-nonproduction-service",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecs:UpdateService",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:service/${ClusterName}/${ServiceName}"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Environment": {
                        "Ref": "Environment"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "DeadLetterQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          },
          {
            "Fn::If": [
              "DatabaseConfigured",
              {
                "PolicyName": "exact-nonproduction-database",
                "PolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": [
                        "rds:StartDBInstance",
                        "rds:StopDBInstance"
                      ],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:rds:${AWS::Region}:${AWS::AccountId}:db:${DatabaseInstanceIdentifier}"
                      },
                      "Condition": {
                        "StringEquals": {
                          "aws:ResourceTag/Environment": {
                            "Ref": "Environment"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "DatabaseStart": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "byus-office-hours-${Environment}-databasestart"
        },
        "GroupName": {
          "Ref": "Group"
        },
        "ScheduleExpression": "cron(45 8 ? * MON-FRI *)",
        "ScheduleExpressionTimezone": "Asia/Seoul",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": {
          "Fn::If": [
            "DatabaseSchedulesEnabled",
            "ENABLED",
            "DISABLED"
          ]
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:rds:startDBInstance"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "Role",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"DbInstanceIdentifier\":\"${DatabaseInstanceIdentifier}\"}"
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "DeadLetterQueue",
                "Arn"
              ]
            }
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 900,
            "MaximumRetryAttempts": 10
          }
        }
      },
      "Condition": "DatabaseConfigured"
    },
    "WebStart": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "byus-office-hours-${Environment}-webstart"
        },
        "GroupName": {
          "Ref": "Group"
        },
        "ScheduleExpression": "cron(0 9 ? * MON-FRI *)",
        "ScheduleExpressionTimezone": "Asia/Seoul",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": {
          "Fn::If": [
            "SchedulesEnabled",
            "ENABLED",
            "DISABLED"
          ]
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:ecs:updateService"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "Role",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"Cluster\":\"${ClusterName}\",\"Service\":\"${ServiceName}\",\"DesiredCount\":1}"
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "DeadLetterQueue",
                "Arn"
              ]
            }
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 900,
            "MaximumRetryAttempts": 10
          }
        }
      }
    },
    "WebStop": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "byus-office-hours-${Environment}-webstop"
        },
        "GroupName": {
          "Ref": "Group"
        },
        "ScheduleExpression": "cron(0 19 ? * MON-FRI *)",
        "ScheduleExpressionTimezone": "Asia/Seoul",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": {
          "Fn::If": [
            "SchedulesEnabled",
            "ENABLED",
            "DISABLED"
          ]
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:ecs:updateService"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "Role",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"Cluster\":\"${ClusterName}\",\"Service\":\"${ServiceName}\",\"DesiredCount\":0}"
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "DeadLetterQueue",
                "Arn"
              ]
            }
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 900,
            "MaximumRetryAttempts": 10
          }
        }
      }
    },
    "DatabaseStop": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {
          "Fn::Sub": "byus-office-hours-${Environment}-databasestop"
        },
        "GroupName": {
          "Ref": "Group"
        },
        "ScheduleExpression": "cron(15 19 ? * MON-FRI *)",
        "ScheduleExpressionTimezone": "Asia/Seoul",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": {
          "Fn::If": [
            "DatabaseSchedulesEnabled",
            "ENABLED",
            "DISABLED"
          ]
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:rds:stopDBInstance"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "Role",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"DbInstanceIdentifier\":\"${DatabaseInstanceIdentifier}\"}"
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "DeadLetterQueue",
                "Arn"
              ]
            }
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 900,
            "MaximumRetryAttempts": 10
          }
        }
      },
      "Condition": "DatabaseConfigured"
    },
    "FailedActionsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Office hours start/stop failed; inspect scheduler DLQ and actual resource state",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DeadLetterQueue",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "ScheduleGroupName": {
      "Value": {
        "Ref": "Group"
      }
    },
    "DeadLetterQueueUrl": {
      "Value": {
        "Ref": "DeadLetterQueue"
      }
    },
    "FailedActionsAlarmName": {
      "Value": {
        "Ref": "FailedActionsAlarm"
      }
    }
  }
}
