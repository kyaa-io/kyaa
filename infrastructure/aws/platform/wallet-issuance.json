{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "kyaa member wallet issuance (PRIVY-EXIT-0005): KMS key and sealed master seed. The web app receives only the public xpub. Create by operator approval only.",
  "Parameters": {
    "Environment": { "Type": "String", "AllowedValues": ["dev", "staging", "prod"] },
    "OperatorRoleArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$",
      "Description": "The only principal that may write or read the master seed (seed generation and rare member key export)."
    }
  },
  "Resources": {
    "SeedKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": { "Fn::Sub": "kyaa ${Environment} member wallet master seed" },
        "KeySpec": "SYMMETRIC_DEFAULT",
        "KeyUsage": "ENCRYPT_DECRYPT",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountAdministration",
              "Effect": "Allow",
              "Principal": { "AWS": { "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root" } },
              "Action": ["kms:Create*", "kms:Describe*", "kms:Enable*", "kms:List*", "kms:Put*", "kms:Update*", "kms:Revoke*", "kms:Disable*", "kms:Get*", "kms:Delete*", "kms:TagResource", "kms:UntagResource", "kms:ScheduleKeyDeletion", "kms:CancelKeyDeletion"],
              "Resource": "*"
            },
            {
              "Sid": "OperatorUseThroughSecretsManagerOnly",
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "OperatorRoleArn" } },
              "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey*", "kms:DescribeKey"],
              "Resource": "*",
              "Condition": { "StringEquals": { "kms:ViaService": { "Fn::Sub": "secretsmanager.${AWS::Region}.amazonaws.com" } } }
            }
          ]
        }
      }
    },
    "SeedKeyAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": { "AliasName": { "Fn::Sub": "alias/kyaa-${Environment}-wallet-seed" }, "TargetKeyId": { "Ref": "SeedKey" } }
    },
    "MasterSeed": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": { "Fn::Sub": "kyaa/${Environment}/wallet-master-seed" },
        "Description": "BIP32 master seed for member record addresses (m/44'/60'/0'/0/i). Value is written once by scripts/privy-exit/wallet-master-generate.mjs; never set by CloudFormation.",
        "KmsKeyId": { "Ref": "SeedKey" }
      }
    },
    "MasterSeedPolicy": {
      "Type": "AWS::SecretsManager::ResourcePolicy",
      "Properties": {
        "SecretId": { "Ref": "MasterSeed" },
        "BlockPublicPolicy": true,
        "ResourcePolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyOperatorReadsOrWritesTheSeed",
              "Effect": "Deny",
              "Principal": "*",
              "Action": ["secretsmanager:GetSecretValue", "secretsmanager:PutSecretValue", "secretsmanager:UpdateSecret"],
              "Resource": "*",
              "Condition": { "StringNotEquals": { "aws:PrincipalArn": { "Ref": "OperatorRoleArn" } } }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "MasterSeedArn": { "Value": { "Ref": "MasterSeed" } },
    "SeedKeyArn": { "Value": { "Fn::GetAtt": ["SeedKey", "Arn"] } }
  }
}
