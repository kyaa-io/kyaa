{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ByUs Seoul network: dedicated production or shared dev/staging; no DNS changes",
  "Parameters": {
    "ProductionAccountId": {
      "Type": "String",
      "AllowedPattern": "\\d{12}"
    },
    "NonproductionAccountId": {
      "Type": "String",
      "AllowedPattern": "\\d{12}"
    },
    "NetworkTier": {
      "Type": "String",
      "AllowedValues": [
        "prod",
        "nonprod"
      ]
    },
    "VpcCidr": {
      "Type": "String",
      "Default": "10.40.0.0/16",
      "AllowedPattern": "10\\.[0-9]+\\.0\\.0/16"
    },
    "AlbCertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:ap-northeast-2:\\d{12}:certificate/[a-zA-Z0-9-]+"
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "Description": "Seoul AWS-managed com.amazonaws.global.cloudfront.origin-facing prefix list ID, resolved with read-only inventory.",
      "AllowedPattern": "pl-[a-f0-9]+"
    }
  },
  "Conditions": {
    "IsProduction": {
      "Fn::Equals": [
        {
          "Ref": "NetworkTier"
        },
        "prod"
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": {
          "Ref": "VpcCidr"
        },
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "byus-${NetworkTier}"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            0,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                6,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "byus-${NetworkTier}-public-1"
            }
          }
        ]
      }
    },
    "AppSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            1,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                6,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "byus-${NetworkTier}-app-1"
            }
          }
        ]
      }
    },
    "DatabaseSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            2,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                6,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "byus-${NetworkTier}-database-1"
            }
          }
        ]
      }
    },
    "PublicAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "NatAddress1": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "GatewayAttachment"
    },
    "Nat1": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatAddress1",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet1"
        }
      }
    },
    "AppRoutes1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "AppRoute1": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRoutes1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat1"
        }
      }
    },
    "AppAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnet1"
        },
        "RouteTableId": {
          "Ref": "AppRoutes1"
        }
      }
    },
    "DatabaseRoutes1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DatabaseAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "DatabaseSubnet1"
        },
        "RouteTableId": {
          "Ref": "DatabaseRoutes1"
        }
      }
    },
    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            3,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                6,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "byus-${NetworkTier}-public-2"
            }
          }
        ]
      }
    },
    "AppSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            4,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                6,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "byus-${NetworkTier}-app-2"
            }
          }
        ]
      }
    },
    "DatabaseSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            5,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                6,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "byus-${NetworkTier}-database-2"
            }
          }
        ]
      }
    },
    "PublicAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet2"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "NatAddress2": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "GatewayAttachment",
      "Condition": "IsProduction"
    },
    "Nat2": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NatAddress2",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet2"
        }
      },
      "Condition": "IsProduction"
    },
    "AppRoutes2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "AppRoute2": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRoutes2"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Fn::If": [
            "IsProduction",
            {
              "Ref": "Nat2"
            },
            {
              "Ref": "Nat1"
            }
          ]
        }
      }
    },
    "AppAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnet2"
        },
        "RouteTableId": {
          "Ref": "AppRoutes2"
        }
      }
    },
    "DatabaseRoutes2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DatabaseAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "DatabaseSubnet2"
        },
        "RouteTableId": {
          "Ref": "DatabaseRoutes2"
        }
      }
    },
    "S3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.s3"
        },
        "RouteTableIds": [
          {
            "Ref": "AppRoutes1"
          },
          {
            "Ref": "AppRoutes2"
          }
        ]
      }
    },
    "PublicAlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Public HTTPS load balancer",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixListId"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "CidrIp": {
              "Ref": "VpcCidr"
            }
          }
        ]
      }
    },
    "PublicAlb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "PublicSubnet1"
          },
          {
            "Ref": "PublicSubnet2"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "PublicAlbSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "deletion_protection.enabled",
            "Value": {
              "Fn::If": [
                "IsProduction",
                "true",
                "false"
              ]
            }
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ]
      },
      "DependsOn": "InternetRoute"
    },
    "PublicListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "PublicAlb"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "AlbCertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "Unknown host"
            }
          }
        ]
      }
    },
    "InternalAlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Internal HTTPS load balancer",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": {
              "Ref": "VpcCidr"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3001,
            "ToPort": 3002,
            "CidrIp": {
              "Ref": "VpcCidr"
            }
          }
        ]
      }
    },
    "InternalAlb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internal",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "AppSubnet1"
          },
          {
            "Ref": "AppSubnet2"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "InternalAlbSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "deletion_protection.enabled",
            "Value": {
              "Fn::If": [
                "IsProduction",
                "true",
                "false"
              ]
            }
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ]
      },
      "DependsOn": "InternetRoute"
    },
    "InternalListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "InternalAlb"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "AlbCertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "Unknown host"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-VpcId"
        }
      }
    },
    "VpcCidr": {
      "Value": {
        "Ref": "VpcCidr"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-VpcCidr"
        }
      }
    },
    "AppSubnet1": {
      "Value": {
        "Ref": "AppSubnet1"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-AppSubnet1"
        }
      }
    },
    "AppSubnet2": {
      "Value": {
        "Ref": "AppSubnet2"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-AppSubnet2"
        }
      }
    },
    "DatabaseSubnet1": {
      "Value": {
        "Ref": "DatabaseSubnet1"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DatabaseSubnet1"
        }
      }
    },
    "DatabaseSubnet2": {
      "Value": {
        "Ref": "DatabaseSubnet2"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DatabaseSubnet2"
        }
      }
    },
    "PublicListenerArn": {
      "Value": {
        "Ref": "PublicListener"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-PublicListenerArn"
        }
      }
    },
    "InternalListenerArn": {
      "Value": {
        "Ref": "InternalListener"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InternalListenerArn"
        }
      }
    },
    "PublicAlbSecurityGroup": {
      "Value": {
        "Ref": "PublicAlbSecurityGroup"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-PublicAlbSecurityGroup"
        }
      }
    },
    "InternalAlbSecurityGroup": {
      "Value": {
        "Ref": "InternalAlbSecurityGroup"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InternalAlbSecurityGroup"
        }
      }
    },
    "PublicAlbDns": {
      "Value": {
        "Fn::GetAtt": [
          "PublicAlb",
          "DNSName"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-PublicAlbDns"
        }
      }
    },
    "InternalAlbDns": {
      "Value": {
        "Fn::GetAtt": [
          "InternalAlb",
          "DNSName"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InternalAlbDns"
        }
      }
    },
    "PublicAlbZoneId": {
      "Value": {
        "Fn::GetAtt": [
          "PublicAlb",
          "CanonicalHostedZoneID"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-PublicAlbZoneId"
        }
      }
    },
    "InternalAlbZoneId": {
      "Value": {
        "Fn::GetAtt": [
          "InternalAlb",
          "CanonicalHostedZoneID"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InternalAlbZoneId"
        }
      }
    },
    "PublicAlbFullName": {
      "Value": {
        "Fn::GetAtt": [
          "PublicAlb",
          "LoadBalancerFullName"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-PublicAlbFullName"
        }
      }
    },
    "InternalAlbFullName": {
      "Value": {
        "Fn::GetAtt": [
          "InternalAlb",
          "LoadBalancerFullName"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InternalAlbFullName"
        }
      }
    },
    "NetworkTier": {
      "Value": {
        "Ref": "NetworkTier"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-NetworkTier"
        }
      }
    },
    "ProductionAccountId": {
      "Value": {
        "Ref": "ProductionAccountId"
      }
    },
    "NonproductionAccountId": {
      "Value": {
        "Ref": "NonproductionAccountId"
      }
    }
  }
}
