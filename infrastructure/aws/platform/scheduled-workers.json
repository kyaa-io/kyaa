    "MintCadenceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "invoke-exact-mint-worker",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Ref": "MintWorkerFunctionArn"
                  }
                }
              ]
            }
          }
        ],
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/byus-${Environment}-worker-runtime-boundary"
        }
      }
    },
    "MintCadenceFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "byus-mint-cadence-${Environment}"
        },
        "Role": {
          "Fn::GetAtt": [
            "MintCadenceRole",
            "Arn"
          ]
        },
        "Runtime": "nodejs24.x",
        "Architectures": [
          "arm64"
        ],
        "Handler": "mint-cadence.handler",
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CronCodeKey"
          }
        },
        "Timeout": 400,
        "MemorySize": 128,
        "ReservedConcurrentExecutions": 8,
        "Environment": {
          "Variables": {
            "WORKER_ENVIRONMENT": {
              "Ref": "Environment"
            },
            "WORKER_ENABLED": {
              "Ref": "EnableSchedules"
            },
            "MINT_WORKER_FUNCTION_ARN": {
              "Ref": "MintWorkerFunctionArn"
            }
          }
        }
      }
    },
    "MintCadenceAsync": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "MintCadenceFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 60
      }
    },
