{
  "name": "@byus/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:lambda": "node scripts/build-lambda.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "historical:dry-run": "npm run build --silent && node dist/historical-action-dry-run.js",
    "action:read-model": "npm run build --silent && node dist/action-read-model-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1091.0",
    "@aws-sdk/client-s3": "3.1091.0",
    "@aws-sdk/client-secrets-manager": "3.1091.0",
    "@aws-sdk/client-sesv2": "3.1091.0",
    "@aws-sdk/credential-providers": "3.1091.0",
    "@supabase/postgrest-js": "2.110.7",
    "@supabase/supabase-js": "2.110.7",
    "@types/web-push": "^3.6.4",
    "viem": "2.55.4",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "esbuild": "^0.25.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
