# This package is intentionally inert unless explicitly enabled.
WORKER_ENABLED=false
PARTICIPATION_LEDGER_ENABLED=false
# Enable after the participation queue migrations and verified contract deployment.
# BYUS_PARTICIPATION_LEDGER_CONTRACT_ADDRESS=0x...
# PARTICIPATION_LEDGER_RPC_URL=https://giwa-sepolia.nodit.io/REPLACE_WITH_KEY
# Keep v1 during a rolling deploy. Set community-stamp-v1 only after the matching DB migration is active.
WORKER_CAPABILITY_VERSION=v1
WORKER_ID=byus-worker-dev-01
WORKER_BATCH_SIZE=5
WORKER_LEASE_SECONDS=120
WORKER_POLL_INTERVAL_MS=5000
WORKER_RECEIPT_POLL_ATTEMPTS=24

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PINATA_JWT=
PINATA_API_URL=https://api.pinata.cloud
METADATA_ASSET_BASE_URI=ipfs://bafyREPLACEWITHVERSIONEDASSETCID/credentials/v1

GIWA_RPC_URL=
GIWA_CHAIN_ID=91342
# Reconcile every pending signed mint before rotating this key; stored retries require the current signer.
GIWA_RELAYER_PRIVATE_KEY=
BYUS_PASSPORT_CONTRACT_ADDRESS=0x17f9FB7658A326DD88dB523739c227faf50Fca20
BYUS_STAMP_CONTRACT_ADDRESS=0x1AdCdE3473c4e884E60205b397ecE744D8892285
GIWA_DEPLOYMENT_BLOCK=
GIWA_MINT_MAX_GAS=1000000
GIWA_MINT_MAX_FEE_PER_GAS_WEI=100000000
GIWA_MINT_MAX_PRIORITY_FEE_PER_GAS_WEI=100000000
GIWA_MINT_MAX_EXECUTION_FEE_WEI=100000000000000
# Optional as a pair. Required before a Dev Collectible job is enabled.
BYUS_COLLECTIBLE_CONTRACT_ADDRESS=
GIWA_COLLECTIBLE_DEPLOYMENT_BLOCK=

# Optional SES email-only mode (requires claim_email_notification_deliveries migration).
# NOTIFICATION_EXTERNAL_MODE=ses_email
# NOTIFICATION_WORKER_BATCH_SIZE=2
# NOTIFICATION_EMAIL_BATCH_SIZE=40
# SES_REGION=ap-northeast-2
# Keep notifications@byus.kr until the kyaa.io SES identity and DNS are verified.
# SES_FROM_EMAIL=notifications@byus.kr

# Independent Kakao Alimtalk queue. Disabled unless all SOLAPI values are set.
KAKAO_ALIMTALK_MODE=disabled
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=

# Optional major-event Telegram alerts. Enable only in the production notification secret.
# NOTIFICATION_EXTERNAL_ENVIRONMENT=prod
# TELEGRAM_ALERT_MODE=disabled
# TELEGRAM_COMMAND_MODE=disabled
# TELEGRAM_CERTIFICATION_REVIEW_MODE=disabled
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
